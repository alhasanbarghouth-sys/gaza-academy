# انسخ هذا الملف إلى .env.local وعبّي القيم من لوحات تحكم Supabase / Google AI Studio.
# انظر README.md لخطوات الحصول على كل قيمة.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# مفتاح سري لا يُستخدم إلا في السيرفر (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Gemini (المساعد الذكي) — مفتاح مجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اختياري: اسم النموذج (الافتراضي gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
